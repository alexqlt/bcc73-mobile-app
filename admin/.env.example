# Copier ce fichier en .env.local et renseigner les valeurs du projet Supabase dev
# (Tableau de bord Supabase > Project Settings > API).
# Les variables NEXT_PUBLIC_ sont envoyées au navigateur : n'y mettre AUCUN secret.

NEXT_PUBLIC_SUPABASE_URL=https://<ref-dev>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
