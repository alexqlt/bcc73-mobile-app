# Copier ce fichier en .env.local et renseigner les valeurs du projet Supabase dev
# (Tableau de bord Supabase > Project Settings > API).
# Les variables EXPO_PUBLIC_ sont incluses dans l'application : n'y mettre AUCUN secret.

EXPO_PUBLIC_SUPABASE_URL=https://<ref-dev>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Adresse du back-office (bouton « Ouvrir le back-office » du profil, visible par les bénévoles).
# En développement sur téléphone, utiliser l'adresse IP de l'ordinateur (ex. http://192.168.1.20:3000).
EXPO_PUBLIC_ADMIN_URL=http://localhost:3000
