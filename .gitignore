# Règles communes au monorepo. Chaque projet (mobile/, admin/) a aussi son propre .gitignore.

# Dépendances
node_modules/

# Variables d'environnement : seuls les fichiers .env.example sont versionnés
.env
.env*.local

# Logs
npm-debug.*
*.log

# Système
.DS_Store
Thumbs.db

# Documents de travail locaux (exemples de fichiers du club), jamais versionnés
/docs/
